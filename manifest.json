{
  "manifest_version": 3,
  "name": "Colorful Bionic Reading",
  "version": "1.0.0",
  "description": "Enhanced bionic reading with customizable colors to improve reading speed and comprehension",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "css": ["bionic.css"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Colorful Bionic Reading"
  },
  "web_accessible_resources": [
    {
      "resources": ["bionic.css"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ]
}