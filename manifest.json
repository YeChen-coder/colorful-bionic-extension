{
  "manifest_version": 3,
  "name": "Colorful Bionic Reading",
  "version": "1.1.0",
  "description": "Enhanced bionic reading with customizable colors to improve reading speed and comprehension",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["settings.js", "renderer.js", "content.js"],
      "css": ["bionic.css"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Colorful Bionic Reading"
  }
}
